<odoo>
    <record id="view_whatsapp_wizard_form" model="ir.ui.view">
        <field name="name">whatsapp.wizard.form</field>
        <field name="model">whatsapp.wizard</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp">
                <group>
                    <field name="partner_id" readonly="1" invisble="1"/>
                    <field name="template_id"/>
                    <field name="message"/>
                </group>

                <footer>
                    <button name="action_send" type="object" string="Send" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_whatsapp_wizard" model="ir.actions.act_window">
        <field name="name">Send WhatsApp</field>
        <field name="res_model">whatsapp.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>